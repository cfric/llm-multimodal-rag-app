# OpenAI
OPENAI_API_KEY=sk-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=...
LLM_AZURE_ENDPOINT=https://<resource>.openai.azure.com/
LLM_AZURE_DEPLOYMENT=gpt-4o
LLM_AZURE_API_VERSION=2024-02-01

# HuggingFace
HUGGINGFACE_API_KEY=hf_...

# Cohere (Reranker)
RERANKER_COHERE_API_KEY=...

# LangSmith
LANGSMITH_API_KEY=ls__...
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=multimodal-rag

# LLM Provider (openai | azure | ollama | huggingface)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Embedding Provider (openai | huggingface)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# VectorStore
VECTORSTORE_PROVIDER=chroma
VECTORSTORE_PERSIST_DIRECTORY=./data/vectorstore
VECTORSTORE_COLLECTION_NAME=multimodal_rag
VECTORSTORE_MIN_RELEVANCE_SCORE=0.35
VECTORSTORE_IMAGE_MIN_RELEVANCE_SCORE=0.55

# ChromaDB HTTP-Modus (leer = embedded/lokal, Hostname = Docker)
VECTORSTORE_CHROMA_HOST=
VECTORSTORE_CHROMA_PORT=8000

# Reranker (crossencoder | cohere)
RERANKER_ENABLED=true
RERANKER_PROVIDER=crossencoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5

# Monitoring
MONITORING_ENABLED=true
MONITORING_PROMETHEUS_PORT=8001

# API
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_MAX_UPLOAD_SIZE_MB=25

# Required for Docker Grafana. Set a unique local password.
GRAFANA_ADMIN_PASSWORD=

# Redis (Semantisches Caching)
REDIS_URL=redis://localhost:6379

# Ollama
LLM_OLLAMA_BASE_URL=http://localhost:11434
