# OpenAI
OPENAI_API_KEY=sk-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=...
LLM_AZURE_ENDPOINT=https://<resource>.openai.azure.com/
LLM_AZURE_DEPLOYMENT=gpt-4o
LLM_AZURE_API_VERSION=2024-02-01

# HuggingFace
HUGGINGFACE_API_KEY=hf_...

# Cohere (Reranker)
RERANKER_COHERE_API_KEY=...

# LangSmith
LANGSMITH_API_KEY=ls__...
LANGSMITH_ENABLED=false
LANGSMITH_PROJECT=multimodal-rag

# LLM Provider (openai | azure | ollama | huggingface)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Embedding Provider (openai | huggingface)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-large

# VectorStore (chroma | qdrant)
VECTORSTORE_PROVIDER=chroma
VECTORSTORE_PERSIST_DIRECTORY=./data/vectorstore
VECTORSTORE_COLLECTION_NAME=multimodal_rag

# Qdrant (falls VECTORSTORE_PROVIDER=qdrant)
VECTORSTORE_QDRANT_URL=http://localhost:6333
VECTORSTORE_QDRANT_API_KEY=

# Reranker (crossencoder | cohere)
RERANKER_ENABLED=true
RERANKER_PROVIDER=crossencoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_N=5

# Monitoring
MONITORING_ENABLED=true
MONITORING_PROMETHEUS_PORT=8001

# API
API_HOST=0.0.0.0
API_PORT=8000

# Redis (Semantisches Caching)
REDIS_URL=redis://localhost:6379

# Ollama
LLM_OLLAMA_BASE_URL=http://localhost:11434
